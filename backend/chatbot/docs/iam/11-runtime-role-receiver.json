{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:<ACCOUNT_ID>:log-group:/aws/lambda/chat-receiver:*"
      ]
    },
    {
      "Sid": "InvokeWorker",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-1:<ACCOUNT_ID>:function:chat-orchestrator-v2"
      ]
    }
  ]
}