{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageWebSocketApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-southeast-1::/apis",
        "arn:aws:apigateway:ap-southeast-1::/apis/*",
        "arn:aws:apigateway:ap-southeast-1::/tags/*"
      ]
    }
  ]
}